<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wq_pill" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
    <FrameLayout android:id="@+id/q_note" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/wq_disc">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:padding="18dp" android:src="@drawable/wi_add" android:tint="@color/b72_wink" android:contentDescription="New note" />
    </FrameLayout>
    <FrameLayout android:id="@+id/q_list" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wq_tone">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/wi_check" android:tint="@color/b72_wdisc" android:contentDescription="q_list" />
    </FrameLayout>
    <FrameLayout android:id="@+id/q_voice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wq_tone">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/wi_mic" android:tint="@color/b72_wdisc" android:contentDescription="q_voice" />
    </FrameLayout>
    <FrameLayout android:id="@+id/q_draw" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wq_tone">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/wi_draw" android:tint="@color/b72_wdisc" android:contentDescription="q_draw" />
    </FrameLayout>
    <FrameLayout android:id="@+id/q_photo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/wq_tone">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/wi_camera" android:tint="@color/b72_wdisc" android:contentDescription="q_photo" />
    </FrameLayout>
</LinearLayout>
